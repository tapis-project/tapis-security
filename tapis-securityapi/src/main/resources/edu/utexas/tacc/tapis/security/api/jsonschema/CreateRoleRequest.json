{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$id": "http://tapis.tacc.utexas.edu/CreateRoleRequest",
    "description": "Top-level schema for a role create request",
    "additionalProperties": false,
    "type": "object",
        "properties": {
          "roleTenant": {
            "type": "string"
          },
          "roleName": {
            "type": "string"
          },
          "roleType": {
            "type": "string",
            "enum": [
              "USER",
              "USER_DEFAULT",
              "TENANT_ADMIN",
              "SITE_ADMIN",
              "RESTRICTED_SERVICE"
            ]
          },
          "description": {
            "type": "string"
          }
        },
    "required": [
        "roleTenant",
        "roleName",
        "description"
    ]
}


