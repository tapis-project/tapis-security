{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$id": "http://tapis.tacc.utexas.edu/GrantUserRoleRequest",
    "description": "Top-level schema for a request to assign a user a role.",
    "additionalProperties": false,
    "type": "object",
        "properties": {
          "tenant": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "roleName": {
            "type": "string"
          },
          "roleType": {
            "type": "string",
            "enum": [
              "USER",
              "USER_DEFAULT",
              "TENANT_ADMIN",
              "SITE_ADMIN",
              "RESTRICTED_SVC"
            ]
          }
        },
    "required": [
        "tenant",
        "user", 
        "roleName"
    ]
}


