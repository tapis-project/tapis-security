{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$id": "http://tapis.tacc.utexas.edu/UpdateRoleDescriptionRequest",
    "description": "Top-level schema for a role description update request",
    "additionalProperties": false,
    "type": "object",
        "properties": {
          "roleTenant": {
            "type": "string"
          },
          "roleType": {
            "type": "string",
            "enum": [
              "USER",
              "USER_DEFAULT",
              "TENANT_ADMIN",
              "SITE_ADMIN",
              "RESTRICTED_SVC"
            ]
          },
          "newDescription": {
            "type": "string"
          }
        },
    "required": [
        "roleTenant",
        "newDescription"
    ]
}


