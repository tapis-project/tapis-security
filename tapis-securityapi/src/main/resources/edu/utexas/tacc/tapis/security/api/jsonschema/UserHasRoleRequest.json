{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$id": "http://tapis.tacc.utexas.edu/UserHasRoleRequest",
    "description": "Top-level schema for a request to check a user's role.",
    "additionalProperties": false,
    "type": "object",
        "properties": {
          "tenant": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "roleName": {
            "type": "string"
          },
          "roleType": {
            "type": "string",
            "enum": [
              "USER",
              "USER_DEFAULT",
              "TENANT_ADMIN",
              "SITE_ADMIN",
              "RESTRICTED_SVC"
            ]
          },
          "orAdmin": {
            "type": "boolean"
          }
        },
    "required": [
        "tenant",
        "user", 
        "roleName"
    ]
}


